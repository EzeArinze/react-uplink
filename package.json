{
  "name": "react-uplink",
  "version": "0.1.0",
  "description": "Accurate, SSR-safe React hook for detecting real network connectivity — not just navigator.onLine.",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "hook",
    "offline",
    "online",
    "network",
    "connectivity",
    "navigator.onLine"
  ],
  "author": "eze arinze",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EzeArinze/react-uplink.git"
  },
  "homepage": "https://github.com/EzeArinze/react-uplink#readme",
  "bugs": {
    "url": "https://github.com/EzeArinze/react-uplink/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
